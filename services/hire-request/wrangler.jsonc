{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thomas-gamboa-hire-request",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://thomasgamboa.github.io,http://localhost:5173",
    "HIRE_FROM_EMAIL": "Portafolio Thomas Gamboa <onboarding@resend.dev>"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
